<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BASE_URL</key>
	<string>$(BASE_URL)</string>
	<key>MSAL_REDIRECT_URI</key>
	<string>$(MSAL_REDIRECT_URI)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(BUNDLE_ID)</string>
	<key>CFBundleName</key>
	<string>$(APP_NAME)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>msauthv2</string>
		<string>msauthv3</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(MSAL_URL_SCHEME)</string>
			</array>
			<key>CFBundleURLName</key>
			<string>$(BUNDLE_ID)</string>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bonjur</string>
			</array>
			<key>CFBundleURLName</key>
			<string>$(BUNDLE_ID).deeplink</string>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
    <key>UIUserInterfaceStyle</key>
    <string>Light</string>
	<key>Environment</key>
	<string>$(ENVIRONMENT)</string>
	<key>MSAL_AUTHORITY_URL</key>
	<string>$(MSAL_AUTHORITY_URL)</string>
	<key>MSAL_CLIENT_ID</key>
	<string>$(MSAL_CLIENT_ID)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>66.70.191.74</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSTemporaryExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<true/>
</dict>
</plist>
